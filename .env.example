# Вставь сюда токен от @BotFather (без кавычек и пробелов)
BOT_TOKEN=вставь_сюда_токен

# --- Локальный запуск (можно не трогать) ---
# PORT=5000
# HOST=127.0.0.1
# DB_PATH=turtlelingo.db
# Туннель localhost.run нужен только локально; на хостинге он отключается сам.
# DISABLE_TUNNEL=1

# --- Railway (вкладка Variables) ---
# PORT выдаётся платформой автоматически, вписывать не надо.
# WEBAPP_URL=https://твой-домен.up.railway.app
# DB_PATH=/data/turtlelingo.db
